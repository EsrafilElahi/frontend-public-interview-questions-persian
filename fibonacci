const cache = { 0: 0, 1: 1 };
const fibo_cached = (n) => {
  if (n in cache) return cache[n];

  cache[n] = fibo_cached(n - 2) + fibo_cached(n - 1);
  return cache[n];
};
// T: o(n)
// S: o(n)


