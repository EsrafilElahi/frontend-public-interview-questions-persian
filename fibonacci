const fibonacci_arr = n => {
  const fibo = [0, 1];
  // fibo[2] ---> [0, 1, (0+1)]

  for (let i = 2; i < n; i++) {
    fibo[i] = fibo[i - 1] + fibo[i - 2];
  }

  return fibo;
};
// T: o(n)
// S: o(n)

const fibo_a_b = n => {
  let a = 0;
  let b = 1;

  // new_a = b(1)
  // new_b = c(0+1)

  for (let i = 2; i < n; i++) {
    const c = a + b;
    a = b;
    b = c;
  }
};
// T: o(n)
// S: o(1)

const fibo_recursive = n => {
  // base case
  if (n < 2) {
    return n;
  }

  // n=5 ---> 4 + 3
  return fibo_recursive(n - 1) + fibo_recursive(n - 2);
};

// T: o(2n)
// S: o(n)



